#!/usr/bin/env sh
# Generic cron tick runner. The agent is invoked with a PROMPT (not --skill/--role flags),
# because that is how headless agents (codex exec, claude -p) actually load a skill.
# Render {{repo_path}}, {{agent_cmd}}, {{role}}, {{timeout_minutes}} during bootstrap.
#
# {{agent_cmd}} examples:
#   codex:  codex exec --cd {{repo_path}} -s workspace-write -c approval_policy='"never"'
#   claude: claude -p --permission-mode acceptEdits
# The runner appends the tick prompt as the final argument.
set -eu

repo="{{repo_path}}"
role="{{role}}"
mins="{{timeout_minutes}}"
prompt="Load the autonomous-work-loops skill and run exactly one ${role} tick in this repository, following its tick-mode instructions. Reconstruct all state from host and .agent-loops/ before acting. Do one unit of work and exit. Do not ask questions."

# External cost wall (ADR-0007): prefer timeout, then gtimeout, else background-kill fallback.
run_with_wall() {
  if command -v timeout  >/dev/null 2>&1; then exec timeout  "${mins}m" "$@"; fi
  if command -v gtimeout >/dev/null 2>&1; then exec gtimeout "${mins}m" "$@"; fi
  "$@" & p=$!; ( sleep "$((mins*60))" && kill -TERM "$p" 2>/dev/null ) & k=$!
  wait "$p"; rc=$?; kill "$k" 2>/dev/null || true; exit "$rc"
}

cd "$repo"
run_with_wall {{agent_cmd}} "$prompt"
