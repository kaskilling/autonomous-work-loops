name: autonomous-work-loops

on:
  schedule:
    - cron: "{{cron}}"
  workflow_dispatch:
    inputs:
      role:
        description: "implementer, reviewer, or fixer"
        required: true
        default: "reviewer"

permissions:
  contents: write
  issues: write
  pull-requests: write

jobs:
  tick:
    runs-on: ubuntu-latest
    timeout-minutes: {{timeout_minutes}}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.AUTONOMOUS_WORK_LOOPS_BOT_TOKEN }}
      - name: Run one loop tick
        env:
          GH_TOKEN: ${{ secrets.AUTONOMOUS_WORK_LOOPS_BOT_TOKEN }}
        run: |
          role="${{ inputs.role || '{{role}}' }}"
          # Skills load by PROMPT, not flags. The job timeout-minutes above is the cost wall.
          {{agent_cmd}} "Load the autonomous-work-loops skill and run one ${role} tick in this repository, following tick-mode. Reconstruct state from host + .agent-loops/. Do one unit of work and exit. Do not ask questions."

# Use a scoped bot token. Do not silently inherit a maintainer's local credentials.
