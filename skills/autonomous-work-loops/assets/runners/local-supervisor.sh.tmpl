#!/usr/bin/env bash
# Local foreground supervisor for autonomous-work-loops.
# Runs one visible tick by default. Pass --watch to keep polling in this
# terminal. It is not a daemon and it does not install cron, launchd, or other
# persistent scheduler entries.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: local-supervisor.sh [--once] [--watch] [--interval seconds] [repo]

Defaults:
  --once       run implementer, reviewer, and fixer once, then exit
  repo         rendered bootstrap repo path

Options:
  --watch      keep polling after each tick
  --interval   polling interval for --watch; default 600
  -h, --help   show this help
EOF
}

mode=once
interval_seconds="${AWL_SUPERVISOR_INTERVAL_SECONDS:-}"
[ -n "$interval_seconds" ] || interval_seconds="{{interval_seconds}}"
case "$interval_seconds" in ""|*"{{"*) interval_seconds=600 ;; esac
repo=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --once)
      mode=once
      shift
      ;;
    --watch)
      mode=watch
      shift
      ;;
    --interval)
      [ "$#" -ge 2 ] || { echo "--interval requires seconds" >&2; exit 2; }
      interval_seconds="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      repo="$1"
      shift
      ;;
  esac
done

[ -n "$repo" ] || repo="{{repo_path}}"

runner="${AWL_ROLE_RUNNER:-}"
if [ -z "$runner" ]; then
  if command -v codex >/dev/null 2>&1 && [ -x "${repo}/.agent-loops/runners/codex.sh" ]; then
    runner="${repo}/.agent-loops/runners/codex.sh"
  elif command -v claude >/dev/null 2>&1 && [ -x "${repo}/.agent-loops/runners/claude.sh" ]; then
    runner="${repo}/.agent-loops/runners/claude.sh"
  else
    echo "No guarded role runner found." >&2
    echo "Install Codex CLI or Claude Code, or set AWL_ROLE_RUNNER to a guarded role runner path." >&2
    exit 1
  fi
fi

if [ ! -x "$runner" ]; then
  echo "Missing executable guarded role runner: $runner" >&2
  exit 1
fi

run_tick() {
  ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  echo "[$ts] autonomous-work-loops supervisor tick"

  echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] role: implementer"
  "$runner" "$repo" implementer || true
  echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] role: reviewer"
  "$runner" "$repo" reviewer || true
  echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] role: fixer"
  "$runner" "$repo" fixer || true
}

run_tick

if [ "$mode" != "watch" ]; then
  echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] one-shot tick complete"
  exit 0
fi

while true; do
  echo "[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] sleeping ${interval_seconds}s"
  sleep "$interval_seconds"
  run_tick
done
